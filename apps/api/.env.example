# =========================================================================
# MCOM SOLUTIONS ECOSYSTEM — SSO + SERVICE MESH (M2M) — EXAMPLE
# Copy the relevant values into your local .env (see apps/api/.env).
# =========================================================================

# Central Hub API gateway (SSO, entitlement, service-token issuance)
MCOM_SOLUTIONS_URL=http://localhost:3010

# OAuth 2.0 SSO & service credentials (MCOM Console → App Details)
MCOM_CLIENT_ID=mcom-rewards
MCOM_CLIENT_SECRET=your-oauth-client-secret

# Server-to-server security (HMAC data sync & webhooks)
MCOM_API_KEY=your-shared-system-api-key
MCOM_HMAC_SECRET=your-hmac-data-sharing-secret
MCOM_WEBHOOK_SECRET=your-webhook-signing-secret
MCOM_PLATFORM_SLUG=mcom-rewards

# ---- Central wallet + MCOM Pay ----
# Wallet is the source of truth; set to false only as a kill switch.
MCOM_WALLET_ENABLED=true
MCOM_PAY_ENABLED=true
# Set the MCOM Console Webhook URL to:
#   {API_PUBLIC_URL}/api/v1/payment/webhook
# MCOM_WEBHOOK_SECRET (above) signs payment.succeeded / payment.refunded.
# Public URL of the Central Hub frontend (NOT the API host).
# Top-up page: {MCOM_CENTRAL_WEB_URL}/dashboard/wallet
MCOM_CENTRAL_WEB_URL=http://localhost:3000
MCOM_REDIRECT_URI=http://localhost:3005/auth/callback
MCOM_SCOPES=profile email business membership packages

# ---- Direct app-to-app communication (service mesh, RS256) ----
MCOM_SERVICE_ENABLED=true
MCOM_SERVICE_BASE_URL=http://localhost:4000
MCOM_SERVICE_SCOPES=rewards:read rewards:issue mall:read mall:write central:read central:issue

# Ingress allow-list of peer clientIds permitted to call this app.
# Comma-separated; "*" allows any registered peer. Empty falls back to the
# Central registry (allowedCallers) with deny-by-default.
MCOM_ALLOWED_CALLERS=fundordonate,mcom-mall,mcom-central

# ---- Outbound partner lifecycle events (direct app-to-app, RS256) ----
# Reward events (issued/redeemed/expired/revoked) are pushed DIRECTLY to the
# peer backend using a short-lived service token. No shared/webhook keys.
MCOM_PARTNER_EVENT_PATH=/api/v1/partner/events
MCOM_PARTNER_EVENT_SCOPE=rewards:issue
# Mall serves its events under its own `mall:write` scope.
MCOM_MALL_EVENT_SCOPE=mall:write

# ---- MCOM Mall peer (rewards → mall) ----
# Fallback base URL, used only when the peer is not in the Central registry
# (or for local development). The registry is preferred in production.
MALL_API_URL=https://api.mall.mcom.com
MCOM_MALL_CLIENT_ID=mcom-mall
# Mall storefront used for reward deep links.
# Precedence: MALL_WEB_URL → MALL_FRONTEND_URL → MALL_APP_URL.
MALL_WEB_URL=http://localhost:3003

# ---- MCOM Central Hub peer (rewards → central) ----
# Fallback base URL, used only when the peer is not in the Central registry.
MCOM_CENTRAL_BASE_URL=https://auth.mcomsolutions.com
MCOM_CENTRAL_CLIENT_ID=mcom-central

# ---- Reward fulfilment ----
# Master switch for provider fulfilment (Mall instruments + Central entitlements).
REWARDS_FULFILMENT_ENABLED=true
REWARDS_CENTRAL_FULFILMENT_ENABLED=true
REWARDS_MALL_TEMPLATES_ENABLED=true
REWARDS_MALL_SCOPED_INSTRUMENTS_ENABLED=true
REWARDS_CENTRAL_EVENTS_ENABLED=true
# Set the MCOM Console Webhook URL for `mcom-rewards` to:
#   {API_PUBLIC_URL}/api/v1/central/events

